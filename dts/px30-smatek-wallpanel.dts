// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Smatek PX30 Home Assistant wall panel (480x480, 4")
 * Android identification: "Rockchip PX30 evb ddr3 board", rockchip,px30-evb-ddr3-v10
 *
 * Derived from the live Android DTB (dts/android-live.dts, audit 10-11-2026)
 * and mainline px30-evb.dts. Every deviation from the EVB is marked "PANEL:".
 *
 * Open points (see docs/hardware.md):
 *  - display: mainline panel-sitronix-st7701 does not have this init sequence
 *    -> own compatible + patch (kernel/st7701-smatek.patch)
 *  - touch CST226SE: handled by mainline hynitron_cstxxx (cst3xx protocol)
 *  - STK3x3x: exact chip ID (reg 0x3e) not read yet
 *  - uart4: connected to unknown peripherals (RS485 in the factory test app)
 *  - mbi5041 LED driver on bit-banged gpio3 (function unknown)
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "px30.dtsi"

/ {
	model = "Smatek PX30 480x480 wall panel";
	compatible = "smatek,px30-wallpanel", "rockchip,px30";

	/* ramoops: identical to Android (0x110000, 960 KiB, same layout), so that
	 * Android shows our kernel log in /sys/fs/pstore after a warm reboot */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@110000 {
			compatible = "ramoops";
			reg = <0x0 0x110000 0x0 0xf0000>;
			record-size = <0x20000>;
			console-size = <0x80000>;
			pmsg-size = <0x50000>;
			ftrace-size = <0x0>;
		};
	};

	aliases {
		mmc0 = &emmc;
		mmc1 = &sdio;
		serial2 = &uart2;
	};

	chosen {
		/* Android: earlyprintk at 0xff160000 = uart2, m0 pins (GPIO1_D2/D3) */
		stdout-path = "serial2:1500000n8";
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 2>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-esc {
			label = "esc";
			linux,code = <KEY_ESC>;
			press-threshold-microvolt = <1310000>;
		};

		button-home {
			label = "home";
			linux,code = <KEY_HOME>;
			press-threshold-microvolt = <624000>;
		};

		button-menu {
			label = "menu";
			linux,code = <KEY_MENU>;
			press-threshold-microvolt = <987000>;
		};

		button-down {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <300000>;
		};

		button-up {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <17000>;
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		/* PANEL: pwm1, 25000 ns = 40 kHz (Android: pwms = <&pwm1 0 25000 0>) */
		pwms = <&pwm1 0 25000 0>;
		power-supply = <&vcc3v3_lcd>;
		brightness-levels = <0 255>;
		num-interpolated-steps = <255>;
		default-brightness-level = <200>;
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk809 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable_h>;
		reset-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_LOW>;
	};

	vcc5v0_sys: regulator-vccsys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "rk809";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphone Jack";
		/* PANEL: routing from Android; speaker output still to be confirmed */
		simple-audio-card,routing =
			"MICL", "Mic Jack",
			"Headphone Jack", "HPOL",
			"Headphone Jack", "HPOR";

		simple-audio-card,codec {
			sound-dai = <&rk809>;
		};

		simple-audio-card,cpu {
			sound-dai = <&i2s1_2ch>;
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

/*
 * Vendor U-Boot leaves aclk_peri_src on CPLL (CLKSEL_CON14 bit 15 = 1).
 * Mainline only knows that mux input as "dummy_cpll" -> the whole peri branch
 * is an orphan with rate 0, and the assigned-clock-rates from px30.dtsi then
 * set the maximum divider: AHB of the peri bus (eMMC, USB OTG, ...) at
 * 96/32 = 3 MHz. Result: dwc2-gadget cannot fill its TX FIFO in time (USB 2.0
 * needs >= 30 MHz AHB) -> Windows "Device Descriptor Request Failed".
 * Fix (same as Android, CLKSEL_CON14 = 0x6705): first switch over to
 * GPLL (1200 MHz), then the normal rates: ACLK 200 MHz, HCLK 150 MHz.
 */
&cru {
	assigned-clocks = <&cru PLL_NPLL>, <&cru ACLK_PERI_SRC>,
		<&cru ACLK_BUS_PRE>, <&cru ACLK_PERI_PRE>,
		<&cru HCLK_BUS_PRE>, <&cru HCLK_PERI_PRE>,
		<&cru PCLK_BUS_PRE>, <&cru SCLK_GPU>;
	assigned-clock-parents = <0>, <&pmucru PLL_GPLL>;
	assigned-clock-rates = <1188000000>, <0>,
		<200000000>, <200000000>,
		<150000000>, <150000000>,
		<100000000>, <200000000>;
};

&display_subsystem {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	ports {
		mipi_out: port@1 {
			reg = <1>;

			mipi_out_panel: endpoint {
				remote-endpoint = <&mipi_in_panel>;
			};
		};
	};

	panel@0 {
		/*
		 * PANEL: Sitronix ST7701(S), 2 lanes, RGB888, 480x480 @ 16 MHz.
		 * Own compatible: the init sequence differs from every panel
		 * that mainline panel-sitronix-st7701 knows today.
		 */
		compatible = "smatek,px30-wallpanel-panel", "sitronix,st7701";
		reg = <0>;
		backlight = <&backlight>;
		IOVCC-supply = <&vcc_1v8>;
		VCC-supply = <&vcc3v3_lcd>;
		/*
		 * Physically active-low (Android: flags 1), but panel-sitronix-st7701
		 * inverts the logic itself (set_value(1) = reset released). The
		 * binding therefore prescribes GPIO_ACTIVE_HIGH; with ACTIVE_LOW the
		 * panel stayed in reset forever (black screen, debug9 11-11-2026).
		 */
		reset-gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_rst>;

		port {
			mipi_in_panel: endpoint {
				remote-endpoint = <&mipi_out_panel>;
			};
		};
	};
};

&dsi_dphy {
	status = "okay";
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	vmmc-supply = <&vcc_3v0>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";
};

/* PANEL: no Ethernet PHY fitted (every MDIO phy_id = 0xffff) -> gmac off */

&gpu {
	mali-supply = <&vdd_log>;
	status = "okay";
};

&i2c0 {
	status = "okay";

	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		/*
		 * i2s1_2ch_mclk: GPIO2_C3 carries the codec MCLK (SCLK_I2S1_OUT).
		 * Android muxes it in its codec node; nothing in mainline does
		 * otherwise, and without MCLK the speaker only crackles or distorts.
		 */
		pinctrl-0 = <&pmic_int>, <&i2s1_2ch_mclk>;
		system-power-controller;
		wakeup-source;
		/* clkout2 = 32k LPO for the RTL8723DS (WiFi+BT); Android: ext_clock = <&rk809 1> */
		#clock-cells = <1>;
		clock-output-names = "rk809-clkout1", "rk809-clkout2";
		#sound-dai-cells = <0>;
		clocks = <&cru SCLK_I2S1_OUT>;
		clock-names = "mclk";
		assigned-clocks = <&cru SCLK_I2S1_OUT>;
		assigned-clock-parents = <&cru SCLK_I2S1>;

		vcc1-supply = <&vcc5v0_sys>;
		vcc2-supply = <&vcc5v0_sys>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc5v0_sys>;

		regulators {
			vdd_log: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vdd_arm: DCDC_REG2 {
				regulator-name = "vdd_arm";
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v0: DCDC_REG4 {
				regulator-name = "vcc_3v0";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};

			vcc3v3_sys: DCDC_REG5 {
				regulator-name = "vcc3v3_sys";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v0: LDO_REG1 {
				regulator-name = "vcc_1v0";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vcc_1v8: LDO_REG2 {
				regulator-name = "vcc1v8_soc";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdd_1v0: LDO_REG3 {
				regulator-name = "vcc1v0_soc";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vcc3v0_pmu: LDO_REG4 {
				regulator-name = "vcc3v0_pmu";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			/* PANEL: no SD slot; LDO6/7/8/9 (vcc_sd, DVP camera) unused */
			vcc_sd: LDO_REG6 {
				regulator-name = "vcc_sd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc2v8_dvp: LDO_REG7 {
				regulator-name = "vcc2v8_dvp";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				/* Android: always-on; keep it on until we know what is connected */
				regulator-always-on;
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-name = "vcc1v8_dvp";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-always-on;
			};

			vdd1v5_dvp: LDO_REG9 {
				regulator-name = "vdd1v5_dvp1";
				regulator-min-microvolt = <3000000>;
				regulator-max-microvolt = <3000000>;
				regulator-always-on;
			};

			/* PANEL: SWITCH1/2 swapped compared to px30-evb */
			vcc5v0_host: SWITCH_REG1 {
				regulator-name = "vcc5v0_host";
				regulator-always-on;
				regulator-boot-on;
			};

			vcc3v3_lcd: SWITCH_REG2 {
				regulator-name = "vcc3v3_lcd";
				regulator-boot-on;
			};
		};

		rk809_codec: codec {
			rockchip,mic-in-differential;
		};
	};
};

&i2c1 {
	status = "okay";

	/*
	 * PANEL: Hynitron CST226SE (mainline hynitron_cstxxx, cst3xx protocol).
	 * Android: irq = gpio0-13 (level low),
	 * "wake" = gpio0-12 high during operation -> used as reset here (active low).
	 */
	touchscreen@5a {
		/* cst3xx protocol confirmed via i2ctransfer (chkcode 0xcaca5fdc, 480x480) */
		compatible = "hynitron,cst226se", "hynitron,cst340";
		reg = <0x5a>;
		interrupt-parent = <&gpio0>;
		/*
		 * Falling edge: the CST226SE keeps INT low for a while after each
		 * report; level-low re-entered the handler on already
		 * acknowledged data (~30 "cst3xx touch read failure" per tap).
		 */
		interrupts = <RK_PB5 IRQ_TYPE_EDGE_FALLING>;
		reset-gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_int &touch_rst>;
		touchscreen-size-x = <480>;
		touchscreen-size-y = <480>;
		/*
		 * Controller axes are swapped relative to the display: top-right
		 * reports (7,450), bottom-right (472,466) (touchlog, 11-11-2026).
		 */
		touchscreen-swapped-x-y;
	};
};

&i2c2 {
	status = "okay";
	clock-frequency = <100000>;
	i2c-scl-falling-time-ns = <50>;
	i2c-scl-rising-time-ns = <300>;

	/*
	 * PANEL: Sensortek STK3x3x light + proximity. The exact type (3310/3311/3335)
	 * follows from register 0x3e; mainline stk3310 accepts all three.
	 * Android does not use the IRQ (irq_enable = 0, polling); whether GPIO3_C0
	 * is physically wired is unknown -> only add the interrupt after a test.
	 */
	light-sensor@47 {
		compatible = "sensortek,stk3311";
		reg = <0x47>;
		vdd-supply = <&vcc3v3_sys>;
		/* interrupt-parent = <&gpio3>; */
		/* interrupts = <RK_PC0 IRQ_TYPE_EDGE_FALLING>; */
	};

	/* PANEL: unknown device at 0x3c (Android driver "smatek,tp") - not described */
};

&i2s1_2ch {
	status = "okay";
};

&io_domains {
	status = "okay";
	vccio1-supply = <&vcc_1v8>;
	vccio2-supply = <&vccio_sd>;
	vccio3-supply = <&vcc_3v0>;
	vccio4-supply = <&vcc3v0_pmu>;
	vccio5-supply = <&vcc_3v0>;
	/* vccio6 not set in Android (GMAC domain, unused) */
};

&pinctrl {
	lcd {
		lcd_rst: lcd-rst {
			rockchip,pins = <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	sdio-pwrseq {
		wifi_enable_h: wifi-enable-h {
			rockchip,pins = <0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	touchscreen {
		touch_int: touch-int {
			rockchip,pins = <0 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		touch_rst: touch-rst {
			rockchip,pins = <0 RK_PB4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	bluetooth {
		bt_enable: bt-enable {
			rockchip,pins = <0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_dev: bt-wake-dev {
			rockchip,pins = <0 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		bt_wake_host: bt-wake-host {
			rockchip,pins = <0 RK_PB2 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wifi {
		wifi_host_wake: wifi-host-wake {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};

&pmu_io_domains {
	status = "okay";
	pmuio1-supply = <&vcc3v0_pmu>;
	pmuio2-supply = <&vcc3v0_pmu>;
};

&pwm1 {
	status = "okay";
};

&saradc {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&sdio {
	/* PANEL: RTL8723DS Wi-Fi (SDIO 024c:d723) -> mainline rtw88_8723ds */
	#address-cells = <1>;
	#size-cells = <0>;
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	non-removable;
	mmc-pwrseq = <&sdio_pwrseq>;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_3v0>;
	vqmmc-supply = <&vcc_1v8>;
	status = "okay";

	wifi@1 {
		reg = <1>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA5 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_host_wake>;
	};
};

&tsadc {
	rockchip,hw-tshut-mode = <1>;
	rockchip,hw-tshut-polarity = <1>;
	status = "okay";
};

&u2phy {
	status = "okay";

	u2phy_host: host-port {
		status = "okay";
	};

	u2phy_otg: otg-port {
		status = "okay";
	};
};

&uart1 {
	/* PANEL: RTL8723DS Bluetooth (Android: uart1 + RTS as GPIO1_C3) */
	/*
	 * Without DMA: with the dw-uart DMA the TX stalls during the firmware
	 * download ("command 0xfc20 tx timeout"), just like on the RK3326
	 * Gameforce Chi (mainline rk3326-gameforce-chi.dts).
	 */
	/delete-property/ dma-names;
	/delete-property/ dmas;
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_xfer &uart1_cts &uart1_rts>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "realtek,rtl8723ds-bt";
		enable-gpios = <&gpio0 RK_PC1 GPIO_ACTIVE_HIGH>;
		device-wake-gpios = <&gpio0 RK_PA1 GPIO_ACTIVE_HIGH>;
		host-wake-gpios = <&gpio0 RK_PB2 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&bt_enable &bt_wake_dev &bt_wake_host>;
	};
};

&uart2 {
	/* debug console; Android uses m0 (GPIO1_D2/D3) */
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

/*
 * PANEL: uart4 (ff170000) is enabled in Android too, with RTS/CTS. The
 * factory test app uses /dev/ttyS3 and /dev/ttyS4 at 9600 baud for
 * RS485 ("Four85"). GPIO1_D4 (a uart4 pin) is however exported as a sysfs
 * GPIO in Android. Function on this unit unknown -> leave it off.
 */

&uart5 {
	/*
	 * PANEL: Zigbee/Thread module, Silicon Labs EFR32MG13 (TYZS13).
	 * Factory test: /dev/ttyS5 @ 115200. RTS/CTS are muxed (GPIO3_A3/A5)
	 * -> hardware flow control. Used via /dev/ttyThread (udev symlink) by
	 * otbr-agent or the Zigbee TCP bridge (see px30-radio).
	 */
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_xfer &uart5_cts &uart5_rts>;
	uart-has-rtscts;
	status = "okay";
};

&usb20_otg {
	/* OTG port: needed for Loader/Maskrom recovery; under Debian a USB gadget
	 * (NCM network to the PC). No ID pin detection needed. */
	dr_mode = "peripheral";
	status = "okay";
};

/*
 * TEMPORARILY OFF (11-11-2026): the first boot hung completely right after the
 * dwc2 probe, just before EHCI/OHCI (last line 0.437 s "hub 1-0:1.0: 1 port
 * detected"). Android gives these nodes 2 clocks (HCLK_HOST + 0x8b), mainline
 * only HCLK_HOST -> probably a missing (arbiter) clock = bus hang.
 * No known USB host port on this panel; OTG (dwc2) stays on.
 */
&usb_host0_ehci {
	status = "disabled";
};

&usb_host0_ohci {
	status = "disabled";
};

&vopb {
	status = "okay";
};

&vopb_mmu {
	status = "okay";
};

&vopl {
	status = "okay";
};

&vopl_mmu {
	status = "okay";
};
