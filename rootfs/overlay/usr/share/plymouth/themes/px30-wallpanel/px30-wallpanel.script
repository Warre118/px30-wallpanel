# Boot animation of the Smatek PX30 wall panel (from Android's bootanimation.zip).
# Original size (240x240, centred, like Android). intro.png 0.3 s, then f0..f264 in a loop at 20 fps.
# Plymouth calls the refresh function 50x per second. Frames are only loaded
# when their turn comes (preloading everything = ~240 MB RAM).

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

FRAMES = 265;
INTRO_TICKS = 15;

anim = Sprite();
anim.SetX(Window.GetX() + (Window.GetWidth() - 240) / 2);
anim.SetY(Window.GetY() + (Window.GetHeight() - 240) / 2);
anim.SetImage(Image("intro.png"));

tick = 0;
shown = -1;

fun refresh_callback() {
  tick++;
  if (tick >= INTRO_TICKS) {
    frame = Math.Int((tick - INTRO_TICKS) * 20 / 50) % FRAMES;
    if (frame != shown) {
      shown = frame;
      anim.SetImage(Image("f" + frame + ".png"));
    }
  }
}

Plymouth.SetRefreshFunction(refresh_callback);
