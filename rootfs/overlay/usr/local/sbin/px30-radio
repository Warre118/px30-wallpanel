#!/usr/bin/python3
"""px30-radio - choose the stack and firmware of the radio module (Tuya TYZS13).

  px30-radio status [--json]            current stack / version / services
  px30-radio probe [--json]             ask the chip which firmware it runs (~11 s;
                                        the radio services are stopped meanwhile)
  px30-radio use thread|zigbee|router|off [--flash] [--yes]
                                        choose the stack. If the chip already runs
                                        it, only its service is turned on (router: no
                                        service); otherwise --flash is needed (= switch,
                                        network lost). off: radio unused, services off
  px30-radio list [--json]              available firmware (catalog)
  px30-radio switch STACK [CHANNEL] [--yes] [--force]
        STACK   thread | zigbee | router
        CHANNEL stable (default) | latest | beta (only when a beta is published)
        --yes   no interactive confirmation (px30-agent: it has its own arm switch)
        --force flash even if this exact version is already on the module
  px30-radio backup                     Thread: save the active dataset to /data/radio/backup
  px30-radio apply                      (boot) run only the chosen stack's service; the
                                        choice lives on /data, systemd's enable state on
                                        the rootfs is lost with every update

Stacks:
  thread  OpenThread RCP + otbr-agent on the panel (Thread border router)
  zigbee  EmberZNet NCP (EZSP); px30-zigbee-bridge serves the UART on TCP port 6638
          for ZHA / Zigbee2MQTT (socket://<panel>:6638). By default it only listens
          on 127.0.0.1; set ZIGBEE_LISTEN=0.0.0.0 in /data/radio/radio.conf to allow
          the LAN (no authentication on that port!).
  router  stand-alone Zigbee router (repeater): joins an open Zigbee network by itself
          (open "permit join" in ZHA / Zigbee2MQTT), needs nothing on the panel. Its CLI
          command "bootloader reboot" lets universal-silabs-flasher update it again.

WARNINGS (shown again before anything is done):
  * switching stack = the network on the module is LOST; every device must be paired again
  * updating / downgrading within a stack = risk of losing the network
    (Thread: the dataset is backed up first; Zigbee: make a ZHA/Z2M backup first)

Exit codes: 0 ok, 1 error, 2 refused (not confirmed / already installed), 3 busy.
Files: /usr/share/px30-radio/catalog.json (+ firmware/), /data/radio/catalog.json
(+ firmware/; downloaded by `px30-update radio sync`, takes precedence),
/data/radio/state.json, /data/radio/radio.conf.
"""
import fcntl, hashlib, json, os, re, subprocess, sys, time

SHARE = "/usr/share/px30-radio"
DATA = "/data/radio"
STATE = DATA + "/state.json"
PROBE = DATA + "/probe.json"
CONF = DATA + "/radio.conf"
LOCK = "/run/px30-radio.lock"
USF = "/opt/usf/bin/universal-silabs-flasher"
DEVICE = "/dev/ttyThread"
STACKS = ("thread", "zigbee", "router")
CHANNELS = ("stable", "latest", "beta")
SERVICE = {"thread": "otbr-agent.service", "zigbee": "px30-zigbee-bridge.service", "router": None}
UNITS = [u for u in SERVICE.values() if u]
# universal-silabs-flasher application type per stack (--probe-methods)
USF_APP = {"thread": "spinel", "zigbee": "ezsp", "router": "router"}
# application type reported by universal-silabs-flasher -> stack
APP_STACK = {"SPINEL": "thread", "EZSP": "zigbee", "GECKO_BOOTLOADER": "bootloader",
             "CPC": "cpc", "ROUTER": "router"}

WARN_STACK = """
  !!! WARNING: STACK SWITCH {old} -> {new} !!!
  The {old_net} network on this module will be LOST. Every device must be
  paired again with {new}. Switching back does not undo this.
"""
WARN_VERSION = """
  !!! WARNING: {kind} {stack} {old} -> {new} !!!
  The network may be lost (e.g. if the new firmware does not take over the
  stored network data). {backup}
"""
BACKUP_HINT = {
    "thread": "The active Thread dataset is saved to /data/radio/backup first.",
    "zigbee": "Make a backup in ZHA (Settings > Zigbee > Backup) or Zigbee2MQTT FIRST.",
    "router": "The router keeps its network if the new firmware takes over its tokens; "
              "otherwise pair it again.",
}


def die(msg, rc=1):
    print(f"px30-radio: {msg}", file=sys.stderr)
    sys.exit(rc)


def load(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def conf():
    c = {"ZIGBEE_LISTEN": "127.0.0.1", "ZIGBEE_PORT": "6638"}
    try:
        for line in open(CONF):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                c[k.strip()] = v.strip().strip('"')
    except OSError:
        pass
    return c


def catalog():
    """Entries {stack, channel, version, file, sha256, ...}; /data overrides /usr/share."""
    entries = {}
    for base in (SHARE, DATA):
        for e in load(base + "/catalog.json", {}).get("firmware", []):
            if e.get("stack") in STACKS and e.get("channel") in CHANNELS and e.get("file"):
                e = dict(e)
                e["path"] = os.path.join(base, "firmware", os.path.basename(e["file"]))
                entries[(e["stack"], e["channel"])] = e
    return entries


def state():
    s = load(STATE, {})
    if s.get("stack") not in STACKS:
        # not recorded yet: guess from the running services (first boot = thread)
        s = {"stack": "thread" if active("otbr-agent.service") else
             ("zigbee" if active("px30-zigbee-bridge.service") else "thread"),
             "version": None, "channel": None, "guessed": True}
    return s


def lock(wait=False):
    """The radio lock (flash, probe); None if another operation holds it."""
    lk = open(LOCK, "w")
    try:
        fcntl.flock(lk, fcntl.LOCK_EX | (0 if wait else fcntl.LOCK_NB))
    except OSError:
        lk.close()
        return None
    return lk


def probe():
    """Ask the chip which firmware it runs. Both services are stopped meanwhile
    (they hold the UART) and the ones that ran are started again. Result in
    /data/radio/probe.json: {stack, app, chip_version, time}; stack is
    thread / zigbee / bootloader (no application) / unknown."""
    res = {"stack": "unknown", "app": None, "chip_version": None,
           "time": time.strftime("%Y-%m-%dT%H:%M:%S%z")}
    if not os.access(USF, os.X_OK):
        res["error"] = "universal-silabs-flasher missing"
        return res
    lk = lock()
    if not lk:
        res["error"] = "busy"
        return res
    try:
        methods = probe_methods(state()["stack"])
        was = [u for u in UNITS if active(u)]
        for u in UNITS:
            subprocess.run(["systemctl", "stop", u], check=False)
        try:
            r = subprocess.run([USF, "--device", DEVICE, "--probe-methods", methods, "probe"],
                               capture_output=True, text=True, timeout=120)
            m = re.search(r"Detected ApplicationType\.(\w+), version '([^']*)'", r.stdout + r.stderr)
            if m:
                res.update(stack=APP_STACK.get(m.group(1), "unknown"), app=m.group(1),
                           chip_version=m.group(2))
        except subprocess.TimeoutExpired:
            res["error"] = "timeout"
        finally:
            for u in was:
                subprocess.run(["systemctl", "start", u], check=False)
    finally:
        lk.close()
    save(PROBE, res)
    return res


def cmd_probe(js):
    res = probe()
    if js:
        print(json.dumps(res))
    else:
        print(f'chip: {res["stack"]}' + (f' ({res["chip_version"]})' if res.get("chip_version") else "")
              + (f' - {res["error"]}' if res.get("error") else ""))


def cmd_use(target, flash, yes):
    s = load(STATE, {})
    known = s.get("stack") if s.get("stack") in STACKS else None
    if target == "off":
        if not known:
            s.update(stack=state()["stack"], guessed=True)
        s["enabled"] = False
        save(STATE, s)
        cmd_apply()
        return
    if target not in STACKS:
        die(f"use: thread, zigbee, router or off")
    chip = known
    if not chip:
        # nothing recorded (first boot, after a factory reset): ask the chip
        p = probe()
        chip = p["stack"] if p["stack"] in STACKS else None
        if chip:
            s.update(stack=chip, chip_version=p.get("chip_version"))
            s.pop("guessed", None)
            save(STATE, s)
    if chip == target:
        s.update(stack=target, enabled=True)
        s.pop("guessed", None)
        save(STATE, s)
        cmd_apply()
        return
    if not flash:
        die(f"the module runs {chip or 'unknown firmware'}; {target} needs flashing, which "
            f"erases the network on it: px30-radio use {target} --flash", 2)
    cmd_switch(target, s.get("channel") or "stable", yes, False)


def active(unit):
    return subprocess.run(["systemctl", "is-active", "--quiet", unit]).returncode == 0


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(65536), b""):
            h.update(b)
    return h.hexdigest()


def vkey(v):
    out = []
    for p in str(v or "").replace("-", ".").split("."):
        out.append((0, int(p)) if p.isdigit() else (1, p))
    return out


def cmd_status(js):
    s = state()
    s["enabled"] = s.get("enabled", True)
    s["probe"] = load(PROBE, None)
    s["services"] = {u: active(u) for u in UNITS}
    s["zigbee_listen"] = conf()["ZIGBEE_LISTEN"]
    if js:
        print(json.dumps(s))
        return
    print(f'stack:   {s["stack"]}{" (guessed)" if s.get("guessed") else ""}'
          f'{"" if s["enabled"] else "  - radio OFF (px30-radio use ...)"}')
    print(f'version: {s.get("version") or "unknown"}  channel: {s.get("channel") or "-"}')
    print(f'flashed: {s.get("flashed") or "-"}')
    for u, a in s["services"].items():
        print(f'{u}: {"active" if a else "off"}')
    if s["stack"] == "zigbee":
        print(f'ZHA/Z2M: socket://<panel>:{conf()["ZIGBEE_PORT"]} (listening on {s["zigbee_listen"]})')


def cmd_list(js):
    cur = state()
    rows = sorted(catalog().values(), key=lambda e: (e["stack"], e["channel"]))
    if js:
        print(json.dumps(rows))
        return
    for e in rows:
        here = os.path.exists(e["path"])
        mark = "*" if (e["stack"] == cur["stack"] and e.get("version") == cur.get("version")) else " "
        print(f'{mark} {e["stack"]:7} {e["channel"]:7} {e.get("version", "?"):24} '
              f'{"" if here else "(not downloaded) "}{e.get("description", "")}')


def thread_backup():
    if not active("otbr-agent.service"):
        print("  (otbr-agent is not running: no Thread dataset to save)")
        return None
    r = subprocess.run(["/usr/sbin/ot-ctl", "dataset", "active", "-x"],
                       capture_output=True, text=True, timeout=20)
    lines = [l.strip() for l in r.stdout.splitlines() if l.strip() and l.strip() != "Done"]
    if r.returncode or not lines or not all(c in "0123456789abcdefABCDEF" for c in lines[0]):
        print("  (no active Thread dataset)")
        return None
    os.makedirs(DATA + "/backup", mode=0o700, exist_ok=True)
    path = f'{DATA}/backup/thread-dataset-{time.strftime("%Y%m%d-%H%M%S")}.hex'
    with open(path, "w") as f:
        f.write(lines[0] + "\n")
    os.chmod(path, 0o600)
    print(f"  Thread dataset saved: {path}")
    print(f"  (restore: ot-ctl dataset set active $(cat {path}) && ot-ctl ifconfig up && ot-ctl thread start)")
    return path


def confirm(word):
    if not sys.stdin.isatty():
        die("no confirmation possible (no terminal); use --yes", 2)
    ans = input(f'  Type "{word}" to continue: ').strip().lower()
    if ans != word:
        die("cancelled", 2)


def probe_methods(first, baud=115200, boot_baud=115200):
    """--probe-methods for universal-silabs-flasher, the expected stack first."""
    order = [USF_APP[first]] if first in USF_APP else []
    order += [m for m in ("ezsp", "spinel", "router") if m not in order]
    return ",".join(f"{m}:{baud}" for m in order) + f",bootloader:{boot_baud}"


def set_services(stack):
    on = SERVICE.get(stack)
    for unit in UNITS:
        if unit != on:
            subprocess.run(["systemctl", "disable", "--now", unit], check=False)
    if on:
        subprocess.run(["systemctl", "enable", "--now", on], check=False)


def cmd_apply():
    """Only the service of the chosen stack (none when the radio is off);
    nothing chosen yet -> leave as is."""
    s = load(STATE, {})
    stack = s.get("stack")
    if stack not in SERVICE:
        print("no stack chosen (px30-radio use ...); nothing changed")
        return
    if s.get("enabled") is False:
        for unit in UNITS:
            if subprocess.run(["systemctl", "is-enabled", "--quiet", unit]).returncode == 0 or active(unit):
                subprocess.run(["systemctl", "disable", "--now", unit], check=False)
        print("radio off: services off")
        return
    on = SERVICE[stack]
    for unit in UNITS:
        want = unit == on
        en = subprocess.run(["systemctl", "is-enabled", "--quiet", unit]).returncode == 0
        if en != want:
            subprocess.run(["systemctl", "enable" if want else "disable", "--now", unit], check=False)
    print(f"{stack}: " + (f"{on} on, " if on else "no service needed, ") +
          ", ".join(u for u in UNITS if u != on) + " off")


def cmd_switch(stack, channel, yes, force):
    if stack not in STACKS:
        die(f"stack must be one of {', '.join(STACKS)}")
    if channel not in CHANNELS:
        die(f"channel must be {' or '.join(CHANNELS)}")
    e = catalog().get((stack, channel))
    if not e:
        die(f"no firmware for {stack}/{channel} in the catalog")
    if not os.path.exists(e["path"]):
        die(f'{e["path"]} missing (not downloaded yet)')
    if e.get("sha256") and sha256(e["path"]) != e["sha256"].lower():
        die(f'checksum of {e["path"]} does not match')
    if not os.access(USF, os.X_OK):
        die(f"{USF} missing (universal-silabs-flasher is not in this image)")

    cur = state()
    old_stack, old_ver, new_ver = cur["stack"], cur.get("version"), e.get("version")
    if stack != old_stack:
        print(WARN_STACK.format(old=old_stack, new=stack, old_net=old_stack.capitalize()))
        word = stack
    elif old_ver == new_ver and not force and not cur.get("guessed"):
        die(f"{stack} {new_ver} is already on the module (--force to flash again)", 2)
    else:
        kind = "UPDATE" if vkey(new_ver) >= vkey(old_ver) else "DOWNGRADE"
        print(WARN_VERSION.format(kind=kind, stack=stack, old=old_ver or "unknown",
                                  new=new_ver, backup=BACKUP_HINT[stack]))
        word = "yes"
    if not yes:
        confirm(word)

    lk = lock()
    if not lk:
        die("another radio operation is running", 3)

    if old_stack == "thread":
        thread_backup()
    # nobody else may hold the UART while flashing
    for u in UNITS:
        subprocess.run(["systemctl", "stop", u], check=False)

    # universal-silabs-flasher >= 1.0: one --probe-methods list; the old
    # --ezsp-baudrate/--spinel-baudrate/--bootloader-baudrate options and the
    # --allow-cross-flashing/--allow-downgrades/--force guards are gone (this
    # script asks for confirmation itself, above)
    argv = [USF, "--device", DEVICE,
            "--probe-methods", probe_methods(old_stack, e.get("baudrate", 115200),
                                             e.get("bootloader_baudrate", 115200)),
            "flash", "--firmware", e["path"]]
    print("  " + " ".join(argv), flush=True)
    rc = subprocess.run(argv).returncode
    if rc != 0:
        # module state unknown: bring the old stack back up, keep the old state file
        set_services(old_stack)
        die(f"flashing failed (rc {rc}); {old_stack} restarted. "
            "If the module no longer answers: recover it over SWD, see docs/radio.md.")

    save(STATE, {"stack": stack, "enabled": True, "channel": channel, "version": new_ver,
                 "file": os.path.basename(e["path"]), "sha256": e.get("sha256"),
                 "flashed": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                 "previous": {"stack": old_stack, "version": old_ver}})
    set_services(stack)
    print(f"done: {stack} {new_ver} ({channel})")
    if stack == "zigbee":
        c = conf()
        print(f'  ZHA/Z2M: socket://<panel>:{c["ZIGBEE_PORT"]} (now listening on {c["ZIGBEE_LISTEN"]})')


def main(a):
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", "-n", sys.argv[0]] + a)
    js = "--json" in a
    a = [x for x in a if x != "--json"]
    if not a or a[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if a[0] == "status":
        cmd_status(js)
    elif a[0] == "list":
        cmd_list(js)
    elif a[0] == "apply":
        cmd_apply()
    elif a[0] == "probe":
        cmd_probe(js)
    elif a[0] == "use" and len(a) >= 2:
        cmd_use(a[1], "--flash" in a, "--yes" in a)
    elif a[0] == "backup":
        thread_backup() or sys.exit(1)
    elif a[0] == "switch" and len(a) >= 2:
        pos = [x for x in a[1:] if not x.startswith("--")]
        cmd_switch(pos[0], pos[1] if len(pos) > 1 else "stable", "--yes" in a, "--force" in a)
    else:
        die("unknown command (px30-radio --help)")


if __name__ == "__main__":
    main(sys.argv[1:])
