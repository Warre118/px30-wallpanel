#!/usr/bin/python3
"""Remote touch input over ssh: a virtual touchscreen (uinput) for one gesture.

    sudo px30-touch tap X Y
    sudo px30-touch swipe X1 Y1 X2 Y2 [ms]       (default 300 ms)
    sudo px30-touch long X Y [ms]                (default 800 ms)
    ssh admin@<panel> sudo px30-touch tap 240 120

Coordinates are screen pixels (0..479, origin top left), as in a
px30-screenshot. Stdlib only; needs CONFIG_INPUT_UINPUT. The device is
created per call, so Cog (libinput) needs a moment to pick it up.
"""
import fcntl, os, struct, sys, time

UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT, UI_SET_PROPBIT = 0x40045564, 0x40045565, 0x40045567, 0x4004556E
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502
EV_SYN, EV_KEY, EV_ABS = 0, 1, 3
BTN_TOUCH = 0x14A
ABS_X, ABS_Y, ABS_MT_SLOT, ABS_MT_X, ABS_MT_Y, ABS_MT_ID = 0x00, 0x01, 0x2F, 0x35, 0x36, 0x39
INPUT_PROP_DIRECT = 1
W = H = 480
SETTLE_S = 1.0      # libinput in Cog adds the new device via udev


def usage():
    sys.exit(__doc__.strip().split("\n\n")[1])


def device():
    fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
    for ev in (EV_KEY, EV_ABS):
        fcntl.ioctl(fd, UI_SET_EVBIT, ev)
    fcntl.ioctl(fd, UI_SET_KEYBIT, BTN_TOUCH)
    fcntl.ioctl(fd, UI_SET_PROPBIT, INPUT_PROP_DIRECT)
    absmax = [0] * 64
    for code, mx in ((ABS_X, W - 1), (ABS_Y, H - 1), (ABS_MT_SLOT, 0),
                     (ABS_MT_X, W - 1), (ABS_MT_Y, H - 1), (ABS_MT_ID, 65535)):
        fcntl.ioctl(fd, UI_SET_ABSBIT, code)
        absmax[code] = mx
    # struct uinput_user_dev: name[80], input_id (bustype=BUS_VIRTUAL), ff_effects_max, abs max/min/fuzz/flat
    dev = struct.pack("80sHHHHi", b"px30-touch (remote)", 0x06, 0x1D6B, 0x0104, 1, 0)
    dev += struct.pack("64i", *absmax) + struct.pack("64i", *[0] * 64) * 3
    os.write(fd, dev)
    fcntl.ioctl(fd, UI_DEV_CREATE)
    time.sleep(SETTLE_S)
    return fd


def emit(fd, *events):
    for t, c, v in events + ((EV_SYN, 0, 0),):
        os.write(fd, struct.pack("qqHHi", 0, 0, t, c, v))


def clamp(v, mx):
    return max(0, min(mx - 1, int(v)))


def down(fd, x, y):
    emit(fd, (EV_ABS, ABS_MT_SLOT, 0), (EV_ABS, ABS_MT_ID, 1), (EV_ABS, ABS_MT_X, x), (EV_ABS, ABS_MT_Y, y),
         (EV_KEY, BTN_TOUCH, 1), (EV_ABS, ABS_X, x), (EV_ABS, ABS_Y, y))


def move(fd, x, y):
    emit(fd, (EV_ABS, ABS_MT_X, x), (EV_ABS, ABS_MT_Y, y), (EV_ABS, ABS_X, x), (EV_ABS, ABS_Y, y))


def up(fd):
    emit(fd, (EV_ABS, ABS_MT_ID, -1), (EV_KEY, BTN_TOUCH, 0))


def main(a):
    if len(a) < 3:
        usage()
    try:
        n = [int(v) for v in a[1:]]
    except ValueError:
        usage()
    if a[0] == "tap" and len(n) == 2:
        pts, ms = [n], 60
    elif a[0] == "long" and len(n) in (2, 3):
        pts, ms = [n[:2]], (n[2] if len(n) == 3 else 800)
    elif a[0] == "swipe" and len(n) in (4, 5):
        ms = n[4] if len(n) == 5 else 300
        steps = max(2, ms // 16)
        pts = [[n[0] + (n[2] - n[0]) * i / steps, n[1] + (n[3] - n[1]) * i / steps] for i in range(steps + 1)]
    else:
        usage()
    pts = [(clamp(x, W), clamp(y, H)) for x, y in pts]
    fd = device()
    try:
        down(fd, *pts[0])
        if len(pts) == 1:
            time.sleep(ms / 1000)
        for p in pts[1:]:
            time.sleep(ms / 1000 / (len(pts) - 1))
            move(fd, *p)
        up(fd)
        time.sleep(0.2)      # let the release reach Cog before the device goes away
    finally:
        fcntl.ioctl(fd, UI_DEV_DESTROY)
        os.close(fd)


main(sys.argv[1:])
