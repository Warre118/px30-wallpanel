#!/bin/sh
# Back to Android. Debian starts from the recovery partition (adb reboot recovery).
# If misc still holds a "boot-recovery" command (Android bootloader message,
# on Rockchip at offset 0 or 16 KiB), this script clears ONLY those 32 bytes
# and then reboots. Otherwise it just reboots.
set -eu
MISC=/dev/disk/by-partlabel/misc
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
for off in 0 16384; do
	cmd="$(dd if="$MISC" bs=1 skip=$off count=32 2>/dev/null | tr -d '\0')"
	case "$cmd" in
	boot-recovery*)
		echo "misc@$off: '$cmd' -> wissen"
		dd if=/dev/zero of="$MISC" bs=1 seek=$off count=32 conv=notrunc,fsync 2>/dev/null
		;;
	esac
done
systemctl reboot
