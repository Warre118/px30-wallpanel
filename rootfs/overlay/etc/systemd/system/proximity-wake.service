[Unit]
Description=Screen on when someone approaches (proximity) or touches
After=systemd-udev-settle.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/bin/proximity-wake.py
RuntimeDirectory=px30-display
RuntimeDirectoryPreserve=yes
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
