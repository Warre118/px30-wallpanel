[Unit]
Description=Display diagnostics to the serial console (debug phase)
After=plymouth-start.service

[Service]
# simple + sleep: does not block boot, runs ~20 s after start
Type=simple
ExecStartPre=/bin/sleep 20
ExecStart=/usr/local/sbin/panel-diag
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
