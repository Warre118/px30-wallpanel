[Unit]
Description=OpenThread Border Router agent (TYZS13-RCP op /dev/ttyThread = UART5)
# Not network-online.target: wait-online also waits for usb0 (gadget) and then hangs 2 min.
# otbr-agent follows the state of wlan0 itself.
Wants=avahi-daemon.service
After=network.target avahi-daemon.service iwd.service dev-ttyThread.device
# waits for the udev symlink (60-px30-serial.rules); stops when it disappears
BindsTo=dev-ttyThread.device

[Service]
EnvironmentFile=-/etc/default/otbr-agent
StateDirectory=thread
ExecStartPre=/usr/sbin/sysctl -q -p /etc/sysctl.d/60-otbr.conf
ExecStart=/usr/sbin/otbr-agent $OTBR_AGENT_OPTS
Restart=on-failure
RestartSec=5
KillMode=mixed

[Install]
WantedBy=multi-user.target
