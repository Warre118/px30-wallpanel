# Config fragment on top of the arm64 defconfig for the Smatek PX30 wall panel.
# Usage: scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig px30-wallpanel.config

# --- SoC / PMIC / regulators (needed to boot -> built in)
CONFIG_ARCH_ROCKCHIP=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_RTC_DRV_RK808=y
CONFIG_INPUT_RK805_PWRKEY=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_SARADC=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_I2C_RK3X=y
CONFIG_PWM_ROCKCHIP=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_PWRSEQ_SIMPLE=y

# --- Display: VOP + MIPI-DSI + ST7701 panel + backlight
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_VOP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_PHY_ROCKCHIP_INNO_DSIDPHY=y
CONFIG_DRM_PANEL_SITRONIX_ST7701=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_DRM_PANFROST=m

# --- Wi-Fi RTL8723DS (SDIO) + Bluetooth (UART, H5)
CONFIG_RTW88=m
CONFIG_RTW88_8723DS=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_RTL=y
CONFIG_BT_RTL=m

# --- Sensors / input
CONFIG_IIO=y
CONFIG_STK3310=m
CONFIG_KEYBOARD_ADC=m

# --- Audio: RK809-codec + I2S + PDM microphone
CONFIG_SND_SOC=m
CONFIG_SND_SOC_ROCKCHIP_I2S=m
CONFIG_SND_SOC_ROCKCHIP_PDM=m
CONFIG_SND_SOC_RK817=m
CONFIG_SND_SIMPLE_CARD=m

# --- USB (OTG + host)
CONFIG_USB_DWC2=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# --- USB gadget: SSH over the OTG cable (NCM), independent of Wi-Fi
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_NCM=y

# --- iwd: required kernel crypto (else "iwd.service failed")
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_MD4=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_ARC4=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y

# --- 1 GB RAM: zram for swap (zstd, as Debian's zram-generator expects)
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=m
CONFIG_CRYPTO_ZSTD=y
# since 6.12 zram picks its algorithms through backends; without these only lzo
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y

# --- diagnostics without a serial cable: kernel log in ramoops (same region as Android),
#     readable after a warm reboot under /sys/fs/pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- touch: Hynitron CST226SE speaks the cst3xx protocol (chkcode 0xcaca,
#     data at 0xd000, ack D0 00 AB) -> mainline hynitron_cstxxx (compat cst340)
CONFIG_TOUCHSCREEN_HYNITRON_CSTXXX=m

# --- uinput: remote taps over ssh (px30-touch), e.g. while the touch cable is
#     unplugged to reach the USB connector
CONFIG_INPUT_UINPUT=y

# --- UART5 (Zigbee/Thread) has alias serial5; with only 4 runtime UARTs it fell
#     back to ttyS0. With 8 it becomes ttyS5 (as on Android).
CONFIG_SERIAL_8250_RUNTIME_UARTS=8
