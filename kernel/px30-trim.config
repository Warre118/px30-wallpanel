# CONFIG_SND_HDA_CORE is not set

# --- recognisable version name instead of "-dirty"
CONFIG_LOCALVERSION="-px30"
# CONFIG_LOCALVERSION_AUTO is not set

# --- 4 cores, 1 GB RAM
CONFIG_NR_CPUS=4
