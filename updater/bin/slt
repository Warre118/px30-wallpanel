#!/bin/sh
# Minimal stand-in for Silicon Labs' `slt` tool installer. Projects generated by
# slc ask `slt where commander` at CMake configure time to find the post-build
# executable; older builder releases rely on that. Answer with the folder of
# the commander stand-in and know nothing else (empty answer = use the
# environment / generated defaults).
if [ "$1" = where ] && [ "$2" = commander ]; then
  dirname "$(command -v commander)"
  exit 0
fi
exit 1
