# Copy to .env (never commit .env).

# GitHub token that may push to the device repositories (config.yaml,
# devices.*.publish.repo): a fine-grained token limited to those repositories,
# "Contents: read and write". Without a token nothing can be pushed and
# upstream checks are limited to 60 requests per hour.
GITHUB_TOKEN=

# Optional: POST a JSON summary here after changes or failures
# (e.g. a Home Assistant webhook automation).
FWPIPE_WEBHOOK=

# Optional: 1 = build and publish into /data/repos/local_<device> only, no push.
FWPIPE_LOCAL_ONLY=

# The ECDSA P-256 signing key is not set here: put it in keys/radio-update.pem
# (mounted at /keys, see config.yaml publish.signing_key and README.md).
